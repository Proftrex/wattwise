plugins {
    id 'com.android.application'
}

android {
    namespace 'com.wattwise.app'
    compileSdk 35

    defaultConfig {
        applicationId "com.wattwise.app"
        minSdk 23
        targetSdk 35
        versionCode 1
        versionName "1.0"
    }
}

dependencies {
    implementation 'androidx.appcompat:appcompat:1.7.0'
}
